{
  "name": "MCP Workshop (Local)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:2-11.0-resolute",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/powershell:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/copilot-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/docker-in-docker": {
      "moby": false
    },
    "./local-features/devproxy": {
      "version": "3.3.1"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.azurecli",
        "ms-vscode.powershell",
        "ms-dotnettools.csharp@prerelease",
        "ms-dotnettools.csdevkit@prerelease",
        "microsoft-aspire.aspire-vscode",
        "github.copilot",
        "github.copilot-chat",
        "github.codespaces",
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-bicep",
        "ms-azuretools.vscode-azurecontainerapps"
      ],
      "settings": {
        "dotnet.preferVisualStudioCodeFileSystemWatcher": true,
        "dotnet.projectsystem.cacheInProjectFolder": true
      },
      "mcp": {
        "servers": {
          "microsoftdocs/mcp": {
              "type": "http",
              "url": "https://learn.microsoft.com/api/mcp"
          }
      },
      "inputs": []
      }
    }
  },
  "containerEnv": {
    "WORKSPACE_ROOT" : "${containerWorkspaceFolder}",
    "DOTNET_DEVCERT_PASSWORD": "${localEnv:DOTNET_DEVCERT_PASSWORD:DefaultPassword!}",
    "SSL_CERT_DIR": "/home/vscode/.aspnet/dev-certs/trust:/usr/lib/ssl/certs"
	},
	"mounts": [
    {
        "type": "bind",
        "source": "${localEnv:HOME}${localEnv:USERPROFILE}/.aspnet/https",
        "target": "/https"
    },
    {
      "type": "volume",
      "source": "x509stores",
      "target": "/home/vscode/.dotnet/corefx/cryptography/x509stores"
    }
  ],

  "forwardPorts": [5000, 5001, 5197, 6274, 15095],
  "portsAttributes": {
    "5001": { "label": "IdentityServer (Lab 5)" },
    "6274": { "label": "MCP Inspector (Lab 1+)" },
    "5197": { "label": "Travel Booking Host (REST + /mcp)" },
    "15095": { "label": "Aspire dashboard" },
    "8000": { "label": "Dev Proxy (Lab 4, local only)", "onAutoForward": "silent" },
    "8897": { "label": "Dev Proxy API (Lab 4, local only)", "onAutoForward": "silent" }
  },

  "onCreateCommand": "sh .devcontainer/local/on-create.sh",
  "postCreateCommand": {
    "script": "sh .devcontainer/local/post-create.sh",
    "apm": "curl -sSL https://aka.ms/apm-unix | sh",
//    "aspire-cli": "curl -sSL https://aspire.dev/install.sh | bash",
    "dotnet": "dotnet --info"
  },

  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}"
}
